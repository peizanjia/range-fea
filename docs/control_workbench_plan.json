{
  "schemaVersion": 1,
  "project": "range-fea",
  "objective": "根据已确认讨论分阶段开发并验收功能完善、操作简单的结构动力学控制工作台",
  "createdAt": "2026-10-11",
  "baselineRootCommit": "46324e8",
  "productComplete": false,
  "requirements": [
    {
      "id": "CW-R01",
      "title": "操作简化",
      "description": "模型、端口、器件、控制器、运行、图表和诊断在同一软件配置；保存的实验运行只需运行及一次整体确认。"
    },
    {
      "id": "CW-R02",
      "title": "主动作动杆",
      "description": "三维主动压电杆与普通杆混用，独立电极端口，轴向刚度/质量/机电耦合，静力/模态/动态及环形桁架控制。"
    },
    {
      "id": "CW-R03",
      "title": "梁板贴片",
      "description": "梁与平板的理想完全粘结压电贴片；自动层合/偏心/附加质量/刚度、电极和动态控制；不得冒充任意曲壳或脱粘。"
    },
    {
      "id": "CW-R04",
      "title": "收放索与锚点",
      "description": "以有效参考长度或规定锚点运动作动，张力由动力学求得；不能把预张力参数当成固定外力。"
    },
    {
      "id": "CW-R05",
      "title": "混合结构",
      "description": "普通杆、主动杆和拉索共同装配及动态求解；环形桁架天线端到端验收。"
    },
    {
      "id": "CW-R06",
      "title": "材料与器件",
      "description": "版本化机械/介电/压电材料和器件预设，d/e与介电条件/单位/极化一致，来源及示例/标定类别可见。"
    },
    {
      "id": "CW-R07",
      "title": "标准传感",
      "description": "虚拟运动学、应变、力/张力及压电电学测量；可选校准/带宽/噪声，设备质量影响与虚拟测量分开。"
    },
    {
      "id": "CW-R08",
      "title": "网格连接",
      "description": "完全覆盖的节点Tie、共用宿主贴片；独立非匹配面投影/插值与覆盖诊断，不用全局合并或增大容差伪装修复。"
    },
    {
      "id": "CW-R09",
      "title": "控制协议与SDK",
      "description": "v3量值端口、Python step(frame,state)和C++常驻程序、可选TCP；v1/v2保持语义和兼容，完整依赖身份。"
    },
    {
      "id": "CW-R10",
      "title": "多速率与接受态",
      "description": "Ts=N*dtFE，独立FE/控制计数、候选事务、保持/调理/限幅、左右加速度、逐相位checkpoint续算。"
    },
    {
      "id": "CW-R11",
      "title": "内置控制与ROM",
      "description": "速度反馈、PID和离散状态空间；同载荷回放与各自闭环比较分开，ROM支持矩阵和误差证据诚实。"
    },
    {
      "id": "CW-R12",
      "title": "本地诊断与Agent",
      "description": "无LLM确定性检查、证据与修复预览；GUI/SDK/Agent同源，Agent不能批准，代码生成隔离门槛不绕过。"
    },
    {
      "id": "CW-R13",
      "title": "验收与发布",
      "description": "独立物理参考、真实窗口、安装私有运行时、兼容及故障恢复，保留20k首图5s/完整导出30s门槛，第三方许可材料核查。"
    },
    {
      "id": "CW-R14",
      "title": "后续功能完整性",
      "description": "应力/区域传感、分布作动/基座运动、曲壳、胶层柔度、热耦合扩展分别交付；硬实时/实物作动不属于已授权首批范围。"
    }
  ],
