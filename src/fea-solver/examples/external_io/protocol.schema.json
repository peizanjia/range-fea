{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Range external I/O protocol version 1",
  "description": "Strict UTF-8 NDJSON, no BOM/duplicate keys/nonfinite numbers. Each frame including newline is bounded by maxLineBytes. Serial requests only; requestId, step, tick are strings. Simulation times are signed finite FE times. Runtime additionally validates exact port sets, quantity/unit/reference, all identity echoes, state digest, roles, sample interval and accepted/candidate state separation.",
  "oneOf": [
    {
      "$ref": "#/$defs/handshakeRequest"
    },
    {
      "$ref": "#/$defs/handshakeResponse"
    },
    {
      "$ref": "#/$defs/evaluateRequest"
    },
    {
      "$ref": "#/$defs/evaluateResponse"
    },
    {
      "$ref": "#/$defs/close"
    }
  ],
  "$defs": {
    "algorithm": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "port": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "direction": {
          "enum": [
            "input",
            "output"
          ]
        },
        "role": {
          "enum": [
            "excitation",
            "controller"
          ]
        },
        "quantity": {
          "enum": [
            "force",
            "moment",
            "displacement",
            "velocity",
            "acceleration",
            "rotation",
            "angularVelocity",
            "angularAcceleration",
            "voltage",
            "charge"
          ]
        },
        "unit": {
          "enum": [
            "N",
            "N m",
            "m",
            "m/s",
            "m/s^2",
            "rad",
            "rad/s",
            "rad/s^2",
            "V",
            "C"
          ]
        },
        "reference": {
          "enum": [
            "absolute",
            "increment"
          ]
        },
        "coordinateSystem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "positiveDirection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "initialValue": {
          "type": "number",
          "minimum": -1.7976931348623157e+308,
          "maximum": 1.7976931348623157e+308
        },
        "binding": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "direction",
        "role",
        "quantity",
        "unit",
        "reference"
      ],
      "additionalProperties": false,
      "allOf": [
        {"oneOf":[{"properties":{"quantity":{"const":"force"},"unit":{"const":"N"}}},{"properties":{"quantity":{"const":"moment"},"unit":{"const":"N m"}}},{"properties":{"quantity":{"const":"displacement"},"unit":{"const":"m"}}},{"properties":{"quantity":{"const":"velocity"},"unit":{"const":"m/s"}}},{"properties":{"quantity":{"const":"acceleration"},"unit":{"const":"m/s^2"}}},{"properties":{"quantity":{"const":"rotation"},"unit":{"const":"rad"}}},{"properties":{"quantity":{"const":"angularVelocity"},"unit":{"const":"rad/s"}}},{"properties":{"quantity":{"const":"angularAcceleration"},"unit":{"const":"rad/s^2"}}},{"properties":{"quantity":{"const":"voltage"},"unit":{"const":"V"}}},{"properties":{"quantity":{"const":"charge"},"unit":{"const":"C"}}}]},
        {
          "if": {
            "properties": {
              "direction": {
                "const": "output"
              },
              "role": {
                "const": "controller"
              }
            }
          },
          "then": {
            "properties": {
              "quantity": {
                "const": "voltage"
              },
              "unit": {
                "const": "V"
              },
              "reference": {
                "const": "absolute"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "excitation"
              }
            }
          },
          "then": {
            "properties": {
              "direction": {
                "const": "output"
              },
              "quantity": {
                "enum": [
                  "force",
                  "moment"
                ]
              }
            }
          }
        }
      ]
    },
    "signal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "value": {
          "type": "number",
          "minimum": -1.7976931348623157e+308,
          "maximum": 1.7976931348623157e+308
        },
        "unit": {
          "enum": [
            "N",
            "N m",
            "m",
            "m/s",
            "m/s^2",
            "rad",
            "rad/s",
            "rad/s^2",
            "V",
            "C"
          ]
        },
        "reference": {
          "enum": [
            "absolute",
            "increment"
          ]
        }
      },
      "required": [
        "id",
        "value",
        "unit",
        "reference"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "transport": {
          "enum": [
            "stdio",
            "tcp"
          ]
        },
        "identityTrust": {
          "enum": [
            "local-files",
            "self-reported"
          ]
        },
        "algorithm": {
          "$ref": "#/$defs/algorithm"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "transport",
        "identityTrust",
        "algorithm",
        "files"
      ],
      "additionalProperties": false
    },
    "handshakeRequest": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "range-external-io/1"
        },
        "op": {
          "const": "handshake"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "requestId": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 4096
        },
        "modelDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "configDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mappingDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "algorithm": {
          "$ref": "#/$defs/algorithm"
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "seed": {},
        "identity": {
          "$ref": "#/$defs/identity"
        }
      },
      "required": [
        "protocol",
        "op",
        "runId",
        "requestId",
        "modelDigest",
        "configDigest",
        "mappingDigest",
        "algorithm",
        "ports",
        "seed",
        "identity"
      ],
      "additionalProperties": false
    },
    "handshakeResponse": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "range-external-io/1"
        },
        "op": {
          "const": "handshake"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "requestId": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 4096
        },
        "modelDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "configDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mappingDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "algorithm": {
          "$ref": "#/$defs/algorithm"
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "capabilities": {
          "type": "object",
          "required": [
            "explicitState"
          ],
          "properties": {
            "explicitState": {
              "const": true
            },
            "futurePreview": {
              "type": "boolean"
            }
          }
        },
        "initialState": {
          "type": "object",
          "properties": {
            "excitation": {},
            "controller": {}
          },
          "minProperties": 1,
          "additionalProperties": false
        }
      },
      "required": [
        "protocol",
        "op",
        "runId",
        "requestId",
        "modelDigest",
        "configDigest",
        "mappingDigest",
        "algorithm",
        "ports",
        "capabilities",
        "initialState"
      ],
      "additionalProperties": false
    },
    "evaluateRequest": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "range-external-io/1"
        },
        "op": {
          "const": "evaluate"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "requestId": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 4096
        },
        "role": {
          "enum": [
            "excitation",
            "controller"
          ]
        },
        "step": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 4096
        },
        "tick": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 4096
        },
        "acceptedStateDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "time": {
          "type": "number",
          "minimum": -1.7976931348623157e+308,
          "maximum": 1.7976931348623157e+308
        },
        "samplePeriod": {
          "type": "number",
          "minimum": -1.7976931348623157e+308,
          "maximum": 1.7976931348623157e+308,
          "exclusiveMinimum": 0
        },
        "validUntil": {
          "type": "number",
          "minimum": -1.7976931348623157e+308,
          "maximum": 1.7976931348623157e+308
        },
        "state": {},
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signal"
          }
        },
        "previousApplied": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signal"
          }
        }
      },
      "required": [
        "protocol",
        "op",
        "runId",
        "requestId",
        "role",
        "step",
        "tick",
        "acceptedStateDigest",
        "time",
        "samplePeriod",
        "validUntil",
        "state",
        "inputs",
        "previousApplied"
      ],
      "additionalProperties": false
    },
    "evaluateResponse": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "range-external-io/1"
        },
        "op": {
          "const": "evaluate"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "requestId": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 4096
        },
        "step": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 4096
        },
        "tick": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 4096
        },
        "acceptedStateDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signal"
          }
        },
        "candidateState": {}
      },
      "required": [
        "protocol",
        "op",
        "runId",
        "requestId",
        "step",
        "tick",
        "acceptedStateDigest",
        "outputs",
        "candidateState"
      ],
      "additionalProperties": false
    },
    "close": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "range-external-io/1"
        },
        "op": {
          "const": "close"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "requestId": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 4096
        }
      },
      "required": [
        "protocol",
        "op",
        "runId",
        "requestId"
      ],
      "additionalProperties": false
    }
  }
}
